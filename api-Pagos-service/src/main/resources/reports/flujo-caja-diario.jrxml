<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="flujo_caja_diario"
              pageWidth="595"
              pageHeight="842"
              columnWidth="535"
              leftMargin="30"
              rightMargin="30"
              topMargin="30"
              bottomMargin="30"
              whenNoDataType="AllSectionsNoDetail"
              uuid="3c983ce9-5c6d-41bb-9454-4112d73d9b12">
    <parameter name="fecha" class="java.lang.String"/>
    <parameter name="totalPagos" class="java.lang.Integer"/>
    <parameter name="totalRecaudado" class="java.lang.Double"/>
    <field name="fechaPago" class="java.lang.String"/>
    <field name="comprobante" class="java.lang.String"/>
    <field name="puesto" class="java.lang.String"/>
    <field name="socio" class="java.lang.String"/>
    <field name="servicio" class="java.lang.String"/>
    <field name="metodoPago" class="java.lang.String"/>
    <field name="monto" class="java.lang.Double"/>
    <title>
        <band height="80">
            <staticText>
                <reportElement x="0" y="0" width="535" height="24"/>
                <textElement textAlignment="Center">
                    <font size="16" isBold="true"/>
                </textElement>
                <text><![CDATA[Flujo de Caja Diario]]></text>
            </staticText>
            <textField>
                <reportElement x="0" y="30" width="535" height="18"/>
                <textElement textAlignment="Center"/>
                <textFieldExpression><![CDATA["Fecha: " + $P{fecha}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="55" width="535" height="18"/>
                <textElement textAlignment="Center"/>
                <textFieldExpression><![CDATA["Pagos: " + $P{totalPagos} + "    Total recaudado: S/ " + String.format("%.2f", $P{totalRecaudado})]]></textFieldExpression>
            </textField>
        </band>
    </title>
    <columnHeader>
        <band height="24">
            <staticText><reportElement x="0" y="0" width="80" height="20"/><textElement><font isBold="true"/></textElement><text><![CDATA[Fecha]]></text></staticText>
            <staticText><reportElement x="80" y="0" width="75" height="20"/><textElement><font isBold="true"/></textElement><text><![CDATA[Comprobante]]></text></staticText>
            <staticText><reportElement x="155" y="0" width="55" height="20"/><textElement><font isBold="true"/></textElement><text><![CDATA[Puesto]]></text></staticText>
            <staticText><reportElement x="210" y="0" width="95" height="20"/><textElement><font isBold="true"/></textElement><text><![CDATA[Socio]]></text></staticText>
            <staticText><reportElement x="305" y="0" width="100" height="20"/><textElement><font isBold="true"/></textElement><text><![CDATA[Servicio]]></text></staticText>
            <staticText><reportElement x="405" y="0" width="65" height="20"/><textElement><font isBold="true"/></textElement><text><![CDATA[Metodo]]></text></staticText>
            <staticText><reportElement x="470" y="0" width="65" height="20"/><textElement textAlignment="Right"><font isBold="true"/></textElement><text><![CDATA[Monto]]></text></staticText>
        </band>
    </columnHeader>
    <detail>
        <band height="22">
            <textField><reportElement x="0" y="0" width="80" height="18"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$F{fechaPago}]]></textFieldExpression></textField>
            <textField><reportElement x="80" y="0" width="75" height="18"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$F{comprobante}]]></textFieldExpression></textField>
            <textField><reportElement x="155" y="0" width="55" height="18"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$F{puesto}]]></textFieldExpression></textField>
            <textField><reportElement x="210" y="0" width="95" height="18"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$F{socio}]]></textFieldExpression></textField>
            <textField><reportElement x="305" y="0" width="100" height="18"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$F{servicio}]]></textFieldExpression></textField>
            <textField><reportElement x="405" y="0" width="65" height="18"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$F{metodoPago}]]></textFieldExpression></textField>
            <textField pattern="#,##0.00"><reportElement x="470" y="0" width="65" height="18"/><textElement textAlignment="Right"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{monto}]]></textFieldExpression></textField>
        </band>
    </detail>
</jasperReport>
